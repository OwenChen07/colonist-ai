# One file per extra account, scripts/vm/bot/accounts/<name>.env (not committed):
PORT=8766
# SIMULATIONS=800
# A human opponent model for the search (opponent_model.py); off by default:
# OPPONENT_MODEL=/home/ubuntu/colonist-ai/models/human/net.npz
# OPPONENT_MIX=0.5
# Play this training round instead of the promoted one (a live test); empty or
# absent follows promotions:
# PIN_ROUND=69
# Play a fixed net file instead of a training round (promotions and PIN_ROUND
# are then ignored); it is reinstalled between games when the file changes.
# NET_NAME names it in the games' label. bot8 plays the people model:
# NET_PATH=/home/ubuntu/colonist-ai/models/human/net.npz
# NET_NAME=people model
