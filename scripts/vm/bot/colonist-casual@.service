[Unit]
Description=Colonist AI: casual 1v1 games for bot account %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/colonist-ai
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
Environment=SIMULATIONS=800
# Per account: PORT (unique on this machine, e.g. 8766), optionally SIMULATIONS.
EnvironmentFile=/home/ubuntu/colonist-ai/scripts/vm/bot/accounts/%i.env
# COLONIST_OWN_ACCOUNTS: all our bot usernames, to spot bot-vs-bot games.
EnvironmentFile=-/home/ubuntu/colonist-ai/scripts/vm/bot/own_accounts.env
ExecStart=/home/ubuntu/colonist-ai/.venv/bin/python -m catanatron.colonist.ranked_runner \
    --account %i --queue casual --port ${PORT} \
    --net /home/ubuntu/colonist-ai/models/%i/model.npz \
    --promotions /home/ubuntu/colonist-ai/runs/g1 \
    --games 0 --simulations ${SIMULATIONS} --viewport 960x540 --max-fps 5
StandardOutput=append:/home/ubuntu/colonist-ai/data/%i/run.log
StandardError=append:/home/ubuntu/colonist-ai/data/%i/run.log
Restart=always
RestartSec=300
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
