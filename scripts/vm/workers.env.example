# Copy to workers.env (not committed). Self-play workers as user@host:processes.
COLONIST_WORKER_HOSTS=owen@10.128.0.4:4
COLONIST_WORKER_ROOT=/home/owen/colonist-ai
COLONIST_LOCAL_WORKERS=8
# Optional measured self-play throughput in hundredths of a game per second.
# Keys are "local" and the exact hosts above; this changes game quotas without
# reducing how many processes a worker runs. Unlisted hosts use 4 per process.
# COLONIST_SELFPLAY_CAPACITIES=local:31,owen@10.128.0.4:18
