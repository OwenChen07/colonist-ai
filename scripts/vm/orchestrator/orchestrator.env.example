# Copy to ~/.config/colonist-orchestrator.env on the coordinator (chmod 600).
# Never commit the real file: it holds the Discord bot's token.
DISCORD_TOKEN=
# Right-click the server / your name in Discord (Developer Mode on) > Copy ID.
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=

ORCHESTRATOR_WORKSTREAMS=efficiency,training,live-loss
# Workers running at once. Pro: 1. Max 5x: 2-3. Change live with !workers N.
ORCHESTRATOR_MAX_WORKERS=1
# A day's budget in API-equivalent dollars (what `claude -p` reports), split
# evenly between the workstreams after the lead's reserve. On a subscription
# the plan's own limits also apply: hitting one pauses Claude for an hour and
# switches the runs to Codex. Tune after a few days with !budget.
ORCHESTRATOR_DAILY_BUDGET_USD=15
ORCHESTRATOR_LEAD_RESERVE=0.3
ORCHESTRATOR_LEAD_MODEL=opus
ORCHESTRATOR_WORKER_MODEL=sonnet
ORCHESTRATOR_CODEX_FALLBACK=1
